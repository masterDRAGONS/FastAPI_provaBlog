# Secret key for JWT signing
SECRET_KEY=your-secret-key-here

# Database URL
# PostgreSQL: postgresql+psycopg://user:password@localhost/dbname
DATABASE_URL=postgresql+psycopg://bloguser:blogpass@localhost/blog

# Email configuration
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=noreply@fastapiblog.com
MAIL_USE_TLS=true

# Frontend URL
FRONTEND_URL=http://localhost:8000

# Storage configuration
# Options: "local" (default) or "azure"
STORAGE_TYPE=local

# Azure Storage configuration (only needed if STORAGE_TYPE=azure)
# Azure Storage Account name (e.g., "mystorageaccount")
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name

# Connection string from Azure (format: DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net)
# Get this from Azure Portal > Storage Account > Access keys
AZURE_STORAGE_ACCOUNT_KEY=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Container name for profile pictures (default: profile-pictures)
AZURE_STORAGE_CONTAINER_NAME=profile-pictures
